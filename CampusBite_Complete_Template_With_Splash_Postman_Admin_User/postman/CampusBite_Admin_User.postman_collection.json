{
  "info": {
    "_postman_id": "b12c9c0d-0cb4-4c68-94d5-campusbiteadminuser",
    "name": "CampusBite API - Admin and User",
    "description": "Tests the seeded CampusBite Admin and Student accounts. Login requests save tokens automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5133"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "userToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 - Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('API health is OK', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('ok'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "2 - Login as Admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@campusbite.com\",\n  \"password\": \"Admin123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Admin login succeeds', function () {",
              "  pm.response.to.have.status(200);",
              "  const data = pm.response.json();",
              "  pm.expect(data.user.role.toLowerCase()).to.eql('admin');",
              "  pm.collectionVariables.set('adminToken', data.token);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "3 - Admin: View Users (should show Admin and Student)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/admin/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Admin can see both demo accounts', function () {",
              "  pm.response.to.have.status(200);",
              "  const users = pm.response.json();",
              "  pm.expect(users.some(u => u.email.toLowerCase() === 'admin@campusbite.com' && u.role.toLowerCase() === 'admin')).to.eql(true);",
              "  pm.expect(users.some(u => u.email.toLowerCase() === 'student@campusbite.com' && u.role.toLowerCase() === 'student')).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4 - Admin: Dashboard Summary",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/admin/summary"
      }
    },
    {
      "name": "5 - Login as Student/User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"student@campusbite.com\",\n  \"password\": \"Student123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Student login succeeds', function () {",
              "  pm.response.to.have.status(200);",
              "  const data = pm.response.json();",
              "  pm.expect(data.user.role.toLowerCase()).to.eql('student');",
              "  pm.collectionVariables.set('userToken', data.token);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "6 - Student/User: View My Orders",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{userToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/orders/mine"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Student can access own orders endpoint', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    }
  ]
}